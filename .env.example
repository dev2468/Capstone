# LLM providers
ZAI_API_KEY=your_zai_api_key_here
ZAI_URL=https://api.z.ai/api/paas/v4/chat/completions
ZAI_MODEL=glm-4-flash

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
DEVMCP_API_KEY=your_hmac_secret_key_here

# AWS
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1

# Kafka (MSK)
KAFKA_BOOTSTRAP_SERVERS=your_msk_bootstrap_endpoint:9092

# DynamoDB table names
DYNAMO_TASKS_TABLE=devmcp-tasks
DYNAMO_EVENTS_TABLE=devmcp-events
DYNAMO_CONVERSATIONS_TABLE=devmcp-conversations
DYNAMO_PREFERENCES_TABLE=devmcp-preferences

# RDS PostgreSQL + pgvector
POSTGRES_HOST=your_rds_endpoint
POSTGRES_PORT=5432
POSTGRES_DB=devmcp
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password

# S3
S3_BUCKET_ARTIFACTS=devmcp-artifacts
S3_BUCKET_SCREENSHOTS=devmcp-screenshots

# Embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Google Workspace OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# GitHub
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret

# Antigravity
AGY_PATH=C:/path/to/agy

# Local paths (customize per machine)
WATCHED_PATHS=C:/Users/HP/Desktop,C:/Users/HP/Documents
DEVMCP_INBOX=C:/DevMCP/inbox
DEVMCP_PROCESSING=C:/DevMCP/processing
DEVMCP_RESULTS=C:/DevMCP/results
